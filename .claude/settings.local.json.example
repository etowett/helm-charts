{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(helm package:*)",
      "Bash(helm show:*)",
      "Bash(helm version:*)",
      "Bash(ct lint:*)",
      "Bash(ct list-changed:*)",
      "Bash(kubeconform:*)",
      "Bash(kind get:*)",
      "Bash(kind create:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(actionlint:*)",
      "Bash(shellcheck:*)",
      "Bash(yamllint:*)",
      "Bash(yq:*)",
      "Bash(jq:*)",
      "Bash(./scripts/doctor.sh:*)",
      "Bash(./scripts/test-hooks.sh:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh api:*)",
      "WebSearch",
      "WebFetch(domain:helm.sh)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:artifacthub.io)"
    ]
  }
}
